# ==============================================================================
# Enterprise Knowledge Copilot - Environment Configuration
# Knowledge Graph RAG for Enterprise Data
# ==============================================================================

# Application Settings
APP_NAME="Enterprise Knowledge Copilot"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=50

# CORS Configuration (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration (Async Driver)
POSTGRES_USER=copilot_user
POSTGRES_PASSWORD=copilot_dev_password
POSTGRES_DB=enterprise_knowledge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://copilot_user:copilot_dev_password@postgres:5432/enterprise_knowledge

# Neo4j Graph Database Configuration (Step 9 - Active Knowledge Graph)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=copilot_graph_dev_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=15.0
NEO4J_MAX_CONNECTION_LIFETIME=3600.0

# Authentication & RBAC Configuration (Step 10)
JWT_SECRET_KEY=dev_insecure_jwt_secret_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (Step 12 - Grounded LLM Generation)
LLM_PROVIDER=ollama # "ollama" (local zero-cost), "openai", or "mock" (offline testing)
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Ollama Local Offline LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# GraphRAG Tri-Hybrid Retrieval Configuration (Step 11)
GRAPHRAG_DENSE_WEIGHT=0.40
GRAPHRAG_SPARSE_WEIGHT=0.30
GRAPHRAG_GRAPH_WEIGHT=0.30
GRAPHRAG_TOP_K=10
GRAPHRAG_MAX_DEPTH=2
GRAPHRAG_MIN_SIMILARITY=0.2
GRAPHRAG_RERANK_ENABLED=True
GRAPHRAG_MAX_CONTEXT_TOKENS=3500

# Embedding Configuration (Step 6)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_API_KEY=your-embedding-api-key-here

# Entity Extraction Configuration (Step 7)
ENTITY_EXTRACTION_PROVIDER=
ENTITY_EXTRACTION_MODEL=gpt-4o-mini
ENTITY_EXTRACTION_BATCH_SIZE=10
ENTITY_EXTRACTION_MAX_RETRIES=3
ENTITY_EXTRACTION_TIMEOUT_SECONDS=60
ENTITY_EXTRACTION_MIN_CONFIDENCE=0.50

# Relationship Extraction Configuration (Step 8)
RELATIONSHIP_EXTRACTION_PROVIDER=
RELATIONSHIP_EXTRACTION_MODEL=gpt-4o-mini
RELATIONSHIP_EXTRACTION_BATCH_SIZE=10
RELATIONSHIP_EXTRACTION_MAX_RETRIES=3
RELATIONSHIP_EXTRACTION_TIMEOUT_SECONDS=60
RELATIONSHIP_EXTRACTION_MIN_CONFIDENCE=0.50

# Frontend Public Settings
NEXT_PUBLIC_API_URL=http://localhost:8000

